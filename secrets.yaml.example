# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is excluded from git — never commit your real credentials.
#
# Generate encryption_key with:   esphome generate-key
# Use any strong random string for ota_password.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"
wifi_fallback_password: "your-fallback-hotspot-password"
ota_password: "your-ota-password"
encryption_key: "generate-with-esphome-generate-key"
# thread_tlv: "only-needed-if-switching-to-openthread"
